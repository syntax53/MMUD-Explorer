+# =====================================================================
+#  MME-Quests.txt  --  Completed-Quest reward definitions (format v2)
+#  for the MMUD Explorer "Completed Quests" character panel.
+# ---------------------------------------------------------------------
+#  This is the SHIPPED DEFAULT set. It is recreated automatically if
+#  missing, so behaviour is identical out of the box. Edit freely.
+#
+#  Per-realm additions/overrides go in MME-QuestsCustom.txt (same
+#  format). A block there with the same Key overrides the built-in;
+#  a block with a new Key is appended as a new quest in the list.
+#
+#  QUEST BLOCK
+#    [Quest <id>]            id = built-in slot number (0..11) or any slug
+#    Key    = <slug>         stable id used for save/paste (never reorder-broken)
+#    Name   = <text>         shown in the list and in stat tooltips
+#    Engine = both|stock|gmud
+#    Choice = <comboField>   0..3 selects which option set; omit = simple quest
+#    Import = <abil>:<min>   (optional) paste ability id that ticks this quest
+#    Export = <abil>|<val>   (optional) ability emitted when exporting char
+#    Reward = <terms>        simple quest
+#    Option<k> = <label> | <terms>   choice quest, k = dropdown index
+#
+#  TERMS (comma separated)  <target>:<value>
+#    sN  accy  accymax  dodge  str        (slot N or special target)
+#    engine qualifier prefix: [stock] or [gmud]   (no prefix = both)
+#  SLOTS: 2=AC 4=Encum 5=MaxHP 6=Mana 7=Crits 9=SC 11=MaxDmg
+#         14=BSMin 15=BSMax 17=ManaRegen 19=Stealth
+# =====================================================================
+
+[Quest 0]
+Key = ice_sorceress
+Name = Ice Sorceress
+Engine = both
+Import = 125:1
+Export = 125|2
+Reward = s2:1
+
+[Quest 1]
+Key = high_druid
+Name = High Druid
+Engine = both
+Import = 129:1
+Export = 129|2
+Reward = s9:1
+
+[Quest 2]
+Key = adult_red_dragon
+Name = Adult Red Dragon
+Engine = both
+Import = 131:2
+Export = 131|3
+Reward = s7:1, s9:2
+
+[Quest 3]
+Key = bishop
+Name = Bishop
+Engine = both
+Import = 130:1
+Export = 130|2
+Reward = [stock]accymax:3, [gmud]accy:3
+
+[Quest 4]
+Key = apparatus
+Name = Apparatus
+Engine = both
+Import = 132:1
+Export = 132|2
+Reward = dodge:1
+
+[Quest 5]
+Key = 2nd_align
+Name = 2nd Align
+Engine = both
+Choice = 0
+Option0 = (none) |
+Option1 = +1 Max Damage (+5 Accy in GMUD) | s11:1, [gmud]accy:5
+Option2 = +1 AC, +6 Mana | s2:1, s6:6
+Option3 = +1 SC / +5 ManaRgn, +10 Mana | s6:10, [stock]s9:1, [gmud]s17:5
+Option4 = +4 Mana, +6 BS Min/Max, +1 Stealth | s6:4, s14:6, s15:6, s19:1
+Option5 = +10 BS Min/Max, +2 Stealth | s14:10, s15:10, s19:2
+Option1_Export = 4|1, [gmud]22|5
+Option2_Export = 69|6, 2|1
+Option3_Export = 69|10, 70|1
+Option4_Export = 69|4, 27|1, 117|6, 118|6
+Option5_Export = 27|2, 117|10, 118|10
+
+[Quest 6]
+Key = opaline
+Name = Opaline
+Engine = gmud
+Import = 200:6
+Export = 88|100, 200|6
+Reward = s5:100
+
+[Quest 7]
+Key = cartographer
+Name = Cartographer
+Engine = gmud
+Import = 203:1
+Export = 96|3, 203|1
+Reward = s4:3
+
+[Quest 8]
+Key = loremaster
+Name = Loremaster
+Engine = gmud
+Import = 202:1
+Export = 2|1, 202|1
+Reward = s2:1
+
+[Quest 9]
+Key = 6th_align
+Name = 6th Align
+Engine = gmud
+Choice = 1
+Option0 = (none) |
+Option1 = War/WHunter/Paladin (+5 Accy,+1 MaxDmg,+5% Enc,+50 HP) | accy:5, s11:1, s4:5, s5:50
+Option2 = Cleric/Warlock (+2 AC,+5 ManaRgn,+3% Enc,+50 HP) | s2:2, s17:5, s4:3, s5:50
+Option3 = Priest/Mage/Druid (+50 SC,+10 ManaRgn,+50 HP) | s9:50, s17:10, s5:50
+Option4 = Missy/Bard/Gypsy (+10 BS,+5 ManaRgn,+10 Stl,+50 HP) | s14:10, s15:10, s17:5, s19:10, s5:50
+Option5 = Thief/Ninja/Ranger (+15 BS,+10 Stl,+50 HP) | s14:15, s15:15, s19:10, s5:50
+Option6 = Mystic (+10 Accy,+1 MaxDmg,+1 Crit,+50 HP) | accy:10, s11:1, s7:1, s5:50
+Option1_Export = 22|5, 4|1, 96|5, 88|50
+Option2_Export = 2|2, 145|5, 96|3, 88|50
+Option3_Export = 70|25, 145|10, 88|50
+Option4_Export = 117|10, 118|10, 145|5, 27|10, 88|50
+Option5_Export = 117|15, 118|15, 27|10, 88|50
+Option6_Export = 22|10, 4|1, 58|1, 88|50
+
+[Quest 10]
+Key = dread_wraith
+Name = Dread Wraith
+Engine = gmud
+Choice = 2
+Option0 = (none) |
+Option1 = War/Pal/Cler/Missy/Ninja/Thief/Bard/Gypsy/WL/Rngr/Mystic (+1 AC,+1 Crit) | s2:1, s7:1
+Option2 = Witchhunter (+1 AC,+2 Crit) | s2:1, s7:2
+Option3 = Priest/Mage/Druid (+1 AC) | s2:1
+Option1_Export = 2|1, 58|1
+Option2_Export = 2|1, 58|2
+Option3_Export = 2|1
+
+[Quest 11]
+Key = renfry
+Name = Renfry
+Engine = gmud
+Choice = 3
+Option0 = (none) |
+Option1 = 1st: +10% Encum, +1 Max Dmg | s4:10, s11:1
+Option2 = 2nd: +10 Strength (plus 1st) | s4:10, str:10, s11:1
+Option1_Export = 96|10, 4|1
+Option2_Export = 96|10, 4|1, 46|10
+
