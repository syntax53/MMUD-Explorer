diff --git a/modTheme.bas b/modTheme.bas
new file mode 100644
index 0000000..b036a9d
--- /dev/null
+++ b/modTheme.bas
@@ -0,0 +1,139 @@
+Attribute VB_Name = "modTheme"
+'======================================================================
+' modTheme - dark-mode skin for the VB6 app shell.
+'----------------------------------------------------------------------
+' VB6 has no native dark mode, so this:
+'   * sets BackColor/ForeColor per control (where the control supports it),
+'   * uses DWM to darken the window title bar (Win10 1809+),
+'   * uses SetWindowTheme("DarkMode_Explorer") to darken combo dropdowns,
+'     list boxes, list/tree views, and scroll bars where the OS allows.
+'
+' Call ApplyTheme(Me) at the end of each form's Form_Load (and after any
+' runtime-generated controls are created). g_DarkMode is persisted in
+' settings.ini and harmonizes with the black frmLoad launcher splash.
+'
+' NOTE: standard VB6 CommandButtons only honor BackColor when their
+' Style = 1 (Graphical). Buttons left as Style 0 stay system-gray; set
+' them Graphical at design time to fully theme them.
+'======================================================================
+Option Explicit
+
+Private Declare Function DwmSetWindowAttribute Lib "dwmapi" ( _
+    ByVal hWnd As Long, ByVal attr As Long, ByRef attrValue As Long, ByVal attrSize As Long) As Long
+Private Declare Function SetWindowTheme Lib "uxtheme" ( _
+    ByVal hWnd As Long, ByVal pszSubAppName As Long, ByVal pszSubIdList As Long) As Long
+Private Declare Function GetDesktopWindow Lib "user32" () As Long
+Private Declare Function lstrlenW Lib "kernel32" (ByVal lpString As Long) As Long
+
+Private Const DWMWA_USE_IMMERSIVE_DARK_MODE As Long = 20
+Private Const DWMWA_USE_IMMERSIVE_DARK_MODE_OLD As Long = 19
+
+Public g_DarkMode As Boolean
+
+' ---- palette ---------------------------------------------------------
+Public Function ThemeWindowBack() As Long:  ThemeWindowBack = IIf(g_DarkMode, RGB(30, 30, 30), vbButtonFace):        End Function
+Public Function ThemePanelBack() As Long:   ThemePanelBack = IIf(g_DarkMode, RGB(37, 37, 38), vbButtonFace):         End Function
+Public Function ThemeText() As Long:        ThemeText = IIf(g_DarkMode, RGB(220, 220, 220), vbWindowText):           End Function
+Public Function ThemeDimText() As Long:     ThemeDimText = IIf(g_DarkMode, RGB(170, 170, 170), vbGrayText):          End Function
+Public Function ThemeInputBack() As Long:   ThemeInputBack = IIf(g_DarkMode, RGB(45, 45, 48), vbWindowBackground):   End Function
+Public Function ThemeInputText() As Long:   ThemeInputText = IIf(g_DarkMode, RGB(230, 230, 230), vbWindowText):      End Function
+Public Function ThemeAccent() As Long:      ThemeAccent = RGB(0, 122, 204):                                          End Function
+
+' ---- persistence -----------------------------------------------------
+Public Sub LoadThemePref()
+    On Error Resume Next
+    g_DarkMode = (val(ReadINI("Settings", "DarkMode", , "0")) <> 0)
+End Sub
+
+Public Sub SaveThemePref()
+    On Error Resume Next
+    Call WriteINI("Settings", "DarkMode", IIf(g_DarkMode, "1", "0"))
+End Sub
+
+' ---- entry points ----------------------------------------------------
+' Apply the current theme to a whole form and its controls.
+Public Sub ApplyTheme(ByRef frm As Form)
+    Dim ctl As control
+    On Error Resume Next
+    frm.BackColor = ThemeWindowBack()
+    DarkTitleBar frm.hWnd, g_DarkMode
+    For Each ctl In frm.Controls
+        ApplyThemeToControl ctl
+    Next ctl
+    frm.Refresh
+End Sub
+
+' Apply to a single control (call after Load()-ing a runtime control too).
+Public Sub ApplyThemeToControl(ByRef ctl As control)
+    Dim tn As String
+    On Error Resume Next
+    tn = TypeName(ctl)
+    Select Case tn
+        Case "Label"
+            ctl.ForeColor = ThemeText()
+            ' transparent labels (BackStyle 0) need no back color
+            If ctl.BackStyle = 1 Then ctl.BackColor = ThemePanelBack()
+        Case "Frame"
+            ctl.BackColor = ThemeWindowBack()
+            ctl.ForeColor = ThemeDimText()
+        Case "CheckBox", "OptionButton"
+            ctl.BackColor = ThemeWindowBack()
+            ctl.ForeColor = ThemeText()
+        Case "PictureBox"
+            ctl.BackColor = ThemePanelBack()
+            ctl.ForeColor = ThemeText()
+        Case "TextBox", "ComboBox", "ListBox"
+            ctl.BackColor = ThemeInputBack()
+            ctl.ForeColor = ThemeInputText()
+            DarkListClient ctl.hWnd
+        Case "ListView", "TreeView", "ListView2", "TreeView2"
+            ctl.BackColor = ThemeInputBack()
+            ctl.ForeColor = ThemeInputText()
+            DarkListClient ctl.hWnd
+        Case "CommandButton"
+            ' only honored when Style = 1 (Graphical)
+            ctl.BackColor = ThemePanelBack()
+            ctl.ForeColor = ThemeText()
+        Case "VScrollBar", "HScrollBar"
+            DarkListClient ctl.hWnd
+        Case Else
+            ctl.BackColor = ThemeWindowBack()
+            ctl.ForeColor = ThemeText()
+    End Select
+End Sub
+
+' ---- Win32 helpers ---------------------------------------------------
+Private Sub DarkTitleBar(ByVal hWnd As Long, ByVal bDark As Boolean)
+    Dim v As Long, r As Long
+    On Error Resume Next
+    If hWnd = 0 Then Exit Sub
+    v = IIf(bDark, 1, 0)
+    r = DwmSetWindowAttribute(hWnd, DWMWA_USE_IMMERSIVE_DARK_MODE, v, 4)
+    If r <> 0 Then DwmSetWindowAttribute hWnd, DWMWA_USE_IMMERSIVE_DARK_MODE_OLD, v, 4
+End Sub
+
+Private Sub DarkListClient(ByVal hWnd As Long)
+    On Error Resume Next
+    If hWnd = 0 Then Exit Sub
+    If g_DarkMode Then
+        SetWindowTheme hWnd, StrPtr("DarkMode_Explorer"), 0
+    Else
+        SetWindowTheme hWnd, StrPtr("Explorer"), 0
+    End If
+End Sub
+
+' Re-skin every currently-loaded form (call after toggling the theme).
+Public Sub ApplyThemeAllForms()
+    Dim f As Form
+    On Error Resume Next
+    For Each f In Forms
+        ApplyTheme f
+    Next f
+End Sub
+
+' Toggle + persist + re-skin a form in one call (for a menu/checkbox).
+Public Sub ToggleDarkMode(ByRef frm As Form)
+    g_DarkMode = Not g_DarkMode
+    SaveThemePref
+    ApplyTheme frm
+End Sub
